# Скопируйте в .env и заполните. Комментарии только на отдельных строках.

# Пароль для входа в админку (логин любой, например admin)
ADMIN_TOKEN=change-me

# Токен бота от @BotFather. Пусто: бот не стартует, админка работает
BOT_TOKEN=

# Куда присылать уведомления о заявках (chat id менеджера)
MANAGER_CHAT_ID=

# Поддомен amoCRM (https://ПОДДОМЕН.amocrm.ru). Пусто: демо-режим без CRM
AMO_SUBDOMAIN=

# Долгосрочный токен интеграции amoCRM
AMO_TOKEN=
